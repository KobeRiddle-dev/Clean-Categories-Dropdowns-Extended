<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Doors (unless Better Architect Menu's door category is present -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/DesignationCategoryDef[defName="Ferny_Doors"]</xpath>

        <nomatch Class="PatchOperationSequence">
            <operations>
                <!-- Add vanilla door to Ferny_Doors if not already in a dropdown -->
                <li Class="PatchOperationConditional">
                    <xpath>Defs/ThingDef[defName="Door"]/designatorDropdown</xpath>
                    <nomatch Class="PatchOperationAdd">
                        <xpath>Defs/ThingDef[defName="Door"]</xpath>
                        <value>
                            <designatorDropdown>Ferny_Doors</designatorDropdown>
                        </value>
                    </nomatch>
                </li>

                <!-- Add VFE Architect single doors to Ferny_Doors -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFEArch_SingleDoor" or defName="VFEArch_SingleDoor_Flipped"]/designatorDropdown</xpath>
                    <value>
                        <designatorDropdown>Ferny_Doors</designatorDropdown>
                    </value>
                </li>
            </operations>
        </nomatch>
    </Operation>

    <!-- Fences -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Fence" or defName="VFEArch_BrickFence" or defName="VFEArch_ChainlinkFence"
            or defName="VFEArch_InvisibleFence" or defName="VFEArch_LowFence" or defName="VFEArch_PicketFence"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_Fences</designatorDropdown>
        </value>
    </Operation>

</Patch>
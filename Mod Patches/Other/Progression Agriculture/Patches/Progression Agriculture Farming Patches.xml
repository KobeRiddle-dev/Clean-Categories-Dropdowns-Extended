<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Seed Packing -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="SeedPackingBench" or defName="SeedPackingCraftingSpot"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_SeedPackingBenches</designatorDropdown>
        </value>
    </Operation>

    <!-- Dropdown item order -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="SeedPackingBench"]/uiOrder</xpath>
        <value>
            <uiOrder>2001</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="SeedPackingCraftingSpot"]/uiOrder</xpath>
        <value>
            <uiOrder>2520</uiOrder>
        </value>
    </Operation>

</Patch>
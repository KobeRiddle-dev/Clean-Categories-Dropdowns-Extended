<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Crates -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_Crate" or defName="sbz_MidCrate" or defName="sbz_SmallCrate" or defName="sbz_TallCrate"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_NeatCrates</designatorDropdown>
        </value>
    </Operation>

    <!-- Pallets -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_Pallet" or defName="sbz_MiniPallet" or defName="sbz_HalfPallet"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_Pallets</designatorDropdown>
        </value>
    </Operation>

    <!-- Display Shelves -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_DisplayShelf" or defName="sbz_SmallDisplayShelf" or defName="sbz_TallDisplayShelf"
            or defName="sbz_NarrowTallDisplayShelf" or defName="sbz_TwoTierDisplayShelf"]</xpath>
        <value>
            <designatorDropdown>Ferny_DisplayShelves</designatorDropdown>
        </value>
    </Operation>

    <!-- Hanger Shelves -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_WideHangerShelf" or defName="sbz_HangerShelf"]</xpath>
        <value>
            <designatorDropdown>Ferny_HangerShelves</designatorDropdown>
        </value>
    </Operation>

    <!-- Display Cabinets -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_DisplayCabinet" or defName="sbz_NarrowDisplayCabinet"]</xpath>
        <value>
            <designatorDropdown>Ferny_DisplayCabinets</designatorDropdown>
        </value>
    </Operation>

    <!-- Open Shelf -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_OpenShelf"]</xpath>
        <value>
            <designatorDropdown>Ferny_Shelves</designatorDropdown>
        </value>
    </Operation>

    <!-- Textile Rack -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_TextileRack"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_TextileStorages</designatorDropdown>
        </value>
    </Operation>

    <!-- Weapon Racks -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="sbz_VerticalWeaponRack" or defName="sbz_HorizontalWeaponRack" or defName="sbz_WeaponRack"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_WeaponRacks</designatorDropdown>
        </value>
    </Operation>

    <!-- Dropdown item order -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_Crate"]/uiOrder</xpath>
        <value>
            <uiOrder>260</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_SmallCrate"]/uiOrder</xpath>
        <value>
            <uiOrder>270</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_TallCrate"]/uiOrder</xpath>
        <value>
            <uiOrder>290</uiOrder>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_MiniPallet"]/uiOrder</xpath>
        <value>
            <uiOrder>310</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_HalfPallet"]/uiOrder</xpath>
        <value>
            <uiOrder>320</uiOrder>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_DisplayShelf"]/uiOrder</xpath>
        <value>
            <uiOrder>150</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_SmallDisplayShelf"]/uiOrder</xpath>
        <value>
            <uiOrder>160</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_NarrowTallDisplayShelf"]/uiOrder</xpath>
        <value>
            <uiOrder>170</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_TwoTierDisplayShelf"]/uiOrder</xpath>
        <value>
            <uiOrder>190</uiOrder>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_HangerShelf"]/uiOrder</xpath>
        <value>
            <uiOrder>200</uiOrder>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="sbz_WideHangerShelf"]/uiOrder</xpath>
        <value>
            <uiOrder>210</uiOrder>
        </value>
    </Operation>

</Patch>
<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Crates -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BasicStorageMediumCrate" or defName="BasicStorageLargeCrate" or defName="BasicStorageMetalCrate" or defName="BasicStorageWoodenCrate"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_PhaneronCrates</designatorDropdown>
        </value>
    </Operation>

    <!-- Pallets -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BasicStoragePalletLarge" or defName="BasicStoragePalletSmall"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_Pallets</designatorDropdown>
        </value>
    </Operation>

    <!-- Dropdown item order -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="BasicStoragePalletSmall"]/uiOrder</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="BasicStoragePalletSmall"]/uiOrder</xpath>
            <value>
                <uiOrder>280</uiOrder>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="BasicStoragePalletSmall"]</xpath>
            <value>
                <uiOrder>280</uiOrder>
            </value>
        </nomatch>
    </Operation>
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="BasicStoragePalletLarge"]/uiOrder</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="BasicStoragePalletLarge"]/uiOrder</xpath>
            <value>
                <uiOrder>290</uiOrder>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="BasicStoragePalletLarge"]</xpath>
            <value>
                <uiOrder>290</uiOrder>
            </value>
        </nomatch>
    </Operation>

    <!-- Food Storages -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BasicStorageFoodBarrel" or defName="BasicStorageFoodCupboard"]</xpath>
        <value>
            <designatorDropdown>KobeRiddle_FoodStuffsStorages</designatorDropdown>
        </value>
    </Operation>

    <!-- Weapon Rack -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Adaptive Primitive Storage</li>
            <li>[sbz] Neat Storage</li>
            <li>[sbz] Gravship Storage</li>
            <li>Vanilla Furniture Expanded</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="BasicStorageWeaponRack"]</xpath>
            <value>
                <designatorDropdown>KobeRiddle_WeaponRacks</designatorDropdown>
            </value>
        </match>
    </Operation>

</Patch>